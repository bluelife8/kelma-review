CREATE TABLE plugin_files (
    plugin_id TEXT NOT NULL,
    file_path TEXT NOT NULL,
    content BLOB NOT NULL,
    PRIMARY KEY (plugin_id, file_path),
    FOREIGN KEY (plugin_id) REFERENCES plugin_installations(plugin_id) ON DELETE CASCADE
);

CREATE TABLE plugin_logs (
    log_id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    plugin_id TEXT NOT NULL,
    occurred_at_ms INTEGER NOT NULL,
    level TEXT NOT NULL,
    message TEXT NOT NULL,
    FOREIGN KEY (plugin_id) REFERENCES plugin_installations(plugin_id) ON DELETE CASCADE
);

CREATE INDEX plugin_logs_plugin_time_idx ON plugin_logs(plugin_id, occurred_at_ms DESC);

CREATE TABLE plugin_host_state (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    safe_mode INTEGER NOT NULL DEFAULT 0
);
